# Copy this file to .env and replace every placeholder before deployment.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=postgres

# URL-encode special characters in the password in DATABASE_URL.
DATABASE_URL=postgresql://postgres:replace-with-a-strong-password@postgres:5432/postgres

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=YOUR_EMAIL@example.com
SMTP_PASSWORD=YOUR_SMTP_APP_PASSWORD

SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# Use the server-side Supabase service-role JWT. Never expose it in frontend code.
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_JWT

OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# Comma-separated frontend origins, for example your Firebase Hosting domains.
CORS_ORIGINS=https://YOUR_PROJECT_ID.web.app,https://YOUR_PROJECT_ID.firebaseapp.com
